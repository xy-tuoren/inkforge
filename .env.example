# InkForge 模型服务配置示例
# 复制为 .env 并填入你的 API Key；不填时默认使用内置 offline demo 引擎体验完整流程

# 可选 provider: demo | deepseek | doubao | qwen | openai | openrouter | ollama | custom
INKFORGE_PROVIDER=demo

# 对应服务商的 API Key（provider=demo 或 ollama 时可留空）
INKFORGE_API_KEY=

# 自定义 Base URL（留空时按 provider 自动填充官方 OpenAI 兼容端点）
INKFORGE_BASE_URL=

# 主力创作模型（用于大纲、正文、精修；留空按 provider 自动选择）
INKFORGE_MODEL=

# 轻量辅助模型（用于状态抽取、快速一致性审查；留空则复用主模型）
INKFORGE_FAST_MODEL=

# 数据存储目录（默认 ./.inkforge）
INKFORGE_DATA_DIR=.inkforge

# --- 常用国产 / 海外服务商参考 ---
# DeepSeek:
#   INKFORGE_PROVIDER=deepseek
#   INKFORGE_API_KEY=sk-xxxx
#   INKFORGE_MODEL=deepseek-chat
#
# 火山方舟 / 豆包 (Doubao):
#   INKFORGE_PROVIDER=doubao
#   INKFORGE_API_KEY=xxxx
#   INKFORGE_MODEL=doubao-1-5-pro-32k-250115
#
# 阿里云百炼 / 通义千问 (Qwen):
#   INKFORGE_PROVIDER=qwen
#   INKFORGE_API_KEY=sk-xxxx
#   INKFORGE_MODEL=qwen-max
#
# 本地 Ollama:
#   INKFORGE_PROVIDER=ollama
#   INKFORGE_MODEL=qwen2.5:14b
